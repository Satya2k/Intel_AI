# IntelliDesk AI Environment Variables
# Copy to .env.local for local overrides

# AI Provider Configuration
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL_ID=gemini-1.5-flash

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Academic Demonstration Mode (true enables self-contained simulated engine with zero external setup)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

